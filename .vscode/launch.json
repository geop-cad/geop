{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Geop VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"],
      "outFiles": ["${workspaceFolder}/vscode-extension/out/**/*.js"],
      "preLaunchTask": "Build Geop VS Code Extension"
    }
  ]
}
