{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../cad/geop-cad-web --target web --out-dir ../../web/src/wasm/pkg --release",
    "predev": "npm run build:wasm",
    "prebuild": "npm run build:wasm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test \"test/*.test.ts\"",
    "preview": "vite preview",
    "build:vscode": "vite build --mode vscode",
    "e2e": "node e2e/web.mjs",
    "e2e:vscode": "node e2e/vscode.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "posthog-js": "^1.434.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "ws": "^8.22.0"
  }
}
