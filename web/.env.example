# PostHog project API key for anonymous usage statistics (see src/analytics.ts).
# Copy to .env.local (gitignored) to test locally; leave unset and the app sends nothing.
# VITE_POSTHOG_KEY=phc_...

# Turnstile site key of the hosted assistant's bot check (public). The deploy
# workflow sets the real one; development uses Cloudflare's always-pass test
# key from .env.development.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFlnEJQiD_GIxiZ-
